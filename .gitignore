# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/
*.log

# Environment / secrets
.env
.env.*
!.env.example
.secrets/
# The same material as an archive rather than a directory (.secrets.rar, .secrets.zip). The directory
# pattern above does not match those, so an archived copy was landing as an untracked file.
.secrets.*
*.key
*.crt
*.pem

# Test coverage
coverage/

# WSAA ticket cache (sensitive auth material at rest). The current default lives under .secrets/cache/ and
# is already covered above; this is the pre-.secrets/ default, kept because a checkout whose .env still
# points at the repo root would otherwise leave live tickets untracked and committable.
.arca-tickets.json

# Editor / OS
.idea/
.vscode/
.DS_Store
