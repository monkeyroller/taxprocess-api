# --- taxprocess-api ---
# HTTP port (distinct from the core API's 4001).
PORT=4101

# Environment mode.
NODE_ENV=development

# CORS origin allowed to call this service (the core API / dev tooling).
CORS_ORIGIN=http://localhost:4200

# WSAA ticket cache location. Dev: a local JSON file. The cache holds only short-lived (~12h) tickets
# this service mints; never the private key. WSAA refuses to re-issue a ticket while a prior one is still
# valid, so run single-node or point every instance at a SHARED path (a shared/Redis-backed store is
# deferred). Tickets are live auth material, so the file sits under ./.secrets/ rather than loose in the
# repo root -- but in cache/, apart from the credentials: this file is DERIVED and safe to delete (it is
# re-minted on demand), whereas a deleted certificate has to be re-issued by the authority.
ARCA_TICKET_CACHE_PATH=./.secrets/cache/arca-tickets.json

# NOTE: this service intentionally stores NO *tenant* secrets at rest — NO ARCA_MASTER_KEY and NO outbound
# URL to core. The encrypted cert/key store lives in webprocess-api; core always initiates requests and
# re-sends with the decrypted credentials attached when this service replies CREDENTIALS_REQUIRED. This
# service holds the key in memory only to mint a ticket, then keeps only the ticket.

# --- Delegate certificate (delegated authorization / ARCA "representación") ---
# The single, bounded exception to "no secrets at rest": OUR OWN organization's ARCA certificate, used to
# issue on behalf of taxpayers that delegated the web service to our CUIT (request field entity.delegated
# = true). It is a platform credential, NOT tenant data — mount it from a secret manager. Certs differ per
# ARCA environment, so configure each one you use. For each environment set EITHER the inline PEM (…_PEM_*)
# OR a file path (…_PATH_*); the inline PEM wins if both are set. Leave an environment unset to disable
# delegation there (a delegated request for it then returns 500 DELEGATION_NOT_CONFIGURED).
#
# Local dev keeps these under ./.secrets/<entity>/<environment>/, mirroring src/providers/<entity>/ -- so a
# second authority is a new sibling directory, not a longer filename. See the layout in the README.
#
# ARCA_DELEGATE_CERT_PATH_PRODUCTION=/run/secrets/arca-delegate-prod.crt
# ARCA_DELEGATE_KEY_PATH_PRODUCTION=/run/secrets/arca-delegate-prod.key
# ARCA_DELEGATE_CERT_PATH_TESTING=./.secrets/arca/testing/delegate.crt
# ARCA_DELEGATE_KEY_PATH_TESTING=./.secrets/arca/testing/delegate.key
# ARCA_DELEGATE_CERT_PEM_TESTING="-----BEGIN CERTIFICATE----- …"
# ARCA_DELEGATE_KEY_PEM_TESTING="-----BEGIN PRIVATE KEY----- …"
#
# Optional boot-time guard: the loaded certificate's CUIT must equal this, or startup fails. Set it to our
# organization's CUIT to catch deploying the wrong certificate.
# ARCA_DELEGATE_TAXID=30711111118

# --- Band probe (pnpm probe:band) ---
# Measures the exchange-rate band ARCA actually enforces, and whether our delegate CUIT may read a
# cotización at all. Homologación ONLY. Read-only by default; PROBE_MODE=full is what authorizes real
# vouchers, and each one consumes a number for (PtoVta, CbteTipo) — so when you set it, point it at a point
# of sale whose numbering you may burn. See scripts/probe-cotizacion-band.ts for why the answer has to be
# measured rather than read off the manual.
#
# PROBE_MODE=full                   # omit for the read-only pass; 'full' burns voucher numbers
# PROBE_POINT_OF_SALE=1
# PROBE_ISSUER_TAXID=30711111118    # omit to issue as the delegate CUIT itself
# PROBE_CURRENCY=DOL
# PROBE_RECEIVER_TAXID=20111111112

# --- Day-semantics probe (pnpm probe:cotizacion-day) ---
# Measures WHICH DAY a cotización is for — what `FEParamGetCotizacion`'s `FchCotiz` selects, which decides
# whether `POST /api/currencies/rates`'s `date` may be passed through verbatim. Read-only in every mode: six
# reads of a public number, no vouchers and no numbering consumed, so it is safe to re-run. Shares
# PROBE_CURRENCY with the band probe above.
#
# PROBE_FERIADO=20260817            # an ARCA `yyyymmdd` feriado in the past; the one case a weekday rule cannot cover
# PROBE_SERIES=1                    # + 24 consecutive days, which is how homologación's generated series was spotted
# PROBE_ENVIRONMENT=production      # ask the REAL authority; needs ARCA_DELEGATE_*_PRODUCTION. Still read-only,
#                                   # and required for this question: homologación's cotizaciones are not market data

# --- Credit-invoice probe (pnpm probe:fecred) ---
# Asks WSFECRED whether a receiver must be sent a Factura de Crédito Electrónica. The WSDL is public and
# already settles the wire shape; what this measures is what a WSDL cannot say — whether our delegate
# certificate is enrolled for `wsfecred` at all (enrolment is independent of `wsfe`, so a certificate good
# for issuing still fails this login), whether the register answers about an arbitrary receiver under our
# own identity, and which business codes come back in `arrayErrores`. Read-only: one query, no vouchers and
# no numbering consumed.
#
# PROBE_RECEIVER=30711111119        # the CUIT asked about; omit for the built-in sample
# PROBE_ISSUE_DATE=2026-09-17       # judge against that day's régimen; omit for today
# PROBE_ENVIRONMENT=production      # the real register; homologación holds no empresas grandes

# --- Export-voucher scripts (pnpm probe:wsfex-smoke, probe:wsfex-rates, dump:wsfex-table) ---
# All three read under our own delegate identity and authorize nothing. They need the certificate enrolled
# for `wsfex` (probe:wsfex-rates needs `wsfe` too); one good for `wsfe` alone fails the WSAA login with
# coe.notAuthorized rather than answering emptily. Ask PRODUCTION for anything that will back validation:
# homologación's reference tables lag the real ones, and its cotizaciones are generated.
#
# PROBE_POINT_OF_SALE=3             # probe:wsfex-smoke — which point of sale FEXGetLast_CMP is asked about
# DUMP_JSON=out.json                # dump:wsfex-table — also write the rows there
# PROBE_ENVIRONMENT=production
