# --- arca-webprocess-api ---
# HTTP port (distinct from the core API's 4001).
PORT=4101

# Environment mode.
NODE_ENV=development

# CORS origin allowed to call this service (the core API / dev tooling).
CORS_ORIGIN=http://localhost:4200

# WSAA ticket cache location. Dev: a local JSON file. Prod: back this with Redis+lock.
# The cache holds only short-lived (~12h) tickets that CORE injects on a renewal re-send —
# never the private key.
ARCA_TICKET_CACHE_PATH=./.arca-tickets.json

# NOTE: this service intentionally has NO ARCA_MASTER_KEY and NO outbound URL to core.
# The private key + credential store live in webprocess-api; core always initiates requests
# and re-sends with a freshly-minted ticket when this service replies TICKET_REQUIRED.
