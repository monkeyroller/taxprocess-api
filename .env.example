# --- tax-webprocess-api ---
# HTTP port (distinct from the core API's 4001).
PORT=4101

# Environment mode.
NODE_ENV=development

# CORS origin allowed to call this service (the core API / dev tooling).
CORS_ORIGIN=http://localhost:4200

# WSAA ticket cache location. Dev: a local JSON file. The cache holds only short-lived (~12h) tickets
# this service mints; never the private key. WSAA refuses to re-issue a ticket while a prior one is still
# valid, so run single-node or point every instance at a SHARED path (a shared/Redis-backed store is
# deferred).
ARCA_TICKET_CACHE_PATH=./.arca-tickets.json

# NOTE: this service intentionally stores NO secrets at rest — NO ARCA_MASTER_KEY and NO outbound URL to
# core. The encrypted cert/key store lives in webprocess-api; core always initiates requests and re-sends
# with the decrypted credentials attached when this service replies CREDENTIALS_REQUIRED. This service
# holds the key in memory only to mint a ticket, then keeps only the ticket.
