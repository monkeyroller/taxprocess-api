{
  "name": "taxprocess-api",
  "version": "0.1.0",
  "description": "Standalone general tax-integration service — dispatches per request on an entity code (ARCA/AFIP today; more entities via the provider registry).",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon",
    "start": "node --loader ts-node/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "probe:band": "node --loader ts-node/esm scripts/probe-cotizacion-band.ts",
    "probe:cotizacion-day": "node --loader ts-node/esm scripts/probe-cotizacion-day.ts",
    "dump:wsfex-table": "node --loader ts-node/esm scripts/dump-wsfex-table.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.0.0",
    "node-forge": "^1.3.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@types/node-forge": "^1.3.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
